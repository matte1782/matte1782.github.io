{"version": 2, "width": 94, "height": 20, "timestamp": 1749470400, "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}, "theme": {"fg": "#ece9e2", "bg": "#12110f"}}
[0.9, "o", "\u001b[2m# sota_bench - every command below runs on a fresh clone (stdlib only)\u001b[0m\r\n"]
[1.6, "o", "\u001b[38;5;179m$\u001b[0m python -m sota_bench baseline\r\n"]
[2.1, "o", "sota_bench | pinned authz_v1 baseline | 16 items | 2026-06-03\r\n"]
[2.42, "o", "  naive    recall 0.833   precision 1.000   Youden J 0.833\r\n"]
[2.74, "o", "  method   recall 0.667   precision 0.800   Youden J 0.567\r\n"]
[3.06, "o", "  signed delta   recall -0.167   Youden J -0.267   :: \u001b[1mthe method LOST\u001b[0m; published as-is.\r\n"]
[3.38, "o", "\u001b[2m  note: aggregate metrics only; the positive corpus is withheld pending\u001b[0m\r\n"]
[3.7, "o", "        coordinated disclosure. the loss, not a win, is the headline (PROTOCOL.md).\r\n"]
[4.2, "o", "\r\n"]
[4.9, "o", "\u001b[38;5;179m$\u001b[0m python -m sota_bench delta\r\n"]
[5.4, "o", "sota_bench | comparability gate\r\n"]
[5.72, "o", "  comparing release-N against the pinned baseline ...\r\n"]
[6.04, "o", "\u001b[31m  ValueError: corpus mismatch: cannot difference across a dataset_hash boundary (new='sha256:9f2c4e' != baseline='sha256:1a7e0b')\u001b[0m\r\n"]
[6.36, "o", "    a delta is only valid against a baseline pinned on the byte-identical corpus\r\n"]
[6.68, "o", "\u001b[32m  >> the benchmark refuses to compare what it cannot honestly compare.\u001b[0m\r\n"]
[7.18, "o", "\r\n"]
[7.88, "o", "\u001b[38;5;179m$\u001b[0m python -m sota_bench admit decode_v1 --n 3\r\n"]
[8.38, "o", "sota_bench | slice-admission gate\r\n"]
[8.7, "o", "  candidate: decode_v1    naive recall 0.333    n=3\r\n"]
[9.02, "o", "\u001b[31m  REJECTED: (MIN_SLICE_N=10)\u001b[0m\r\n"]
[9.34, "o", "    - underpowered slice: n=3 < MIN_SLICE_N=10\r\n"]
[9.66, "o", "\u001b[2m      (naive-weakness over n<10 items is an anecdote, not a measured rate; disqualifier #6: n=1-treated-as-a-rate)\u001b[0m\r\n"]
[9.98, "o", "\u001b[32m  >> suggestive, not a calibrated rate. growing toward n>=10.\u001b[0m\r\n"]
[10.48, "o", "\r\n"]
